NODE_ENV=production
PORT=5000
CLIENT_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Use distinct, cryptographically random secrets of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=codeclash

SECURE_CODE_ENGINE_URL=https://secure-code-engine.example.com/api/v1/execute
SECURE_CODE_ENGINE_TIMEOUT_MS=120000
JUDGE_CALLBACK_SECRET=replace-with-a-long-random-secret

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=mailer@example.com
EMAIL_PASS=replace-with-your-smtp-password
EMAIL_FROM_NAME=CodeClash

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
OTP_EXPIRY_MINUTES=5
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30
LOG_LEVEL=combined
SUPER_ADMIN_EMAIL=admin@example.com
